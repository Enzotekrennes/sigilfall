// Creatures of the dungeon, loaded by `Content::load` and checked before a
// game starts. Every field is required:
//
// - id:        stable key used by saves and spawn tables; lower-case letters,
//              digits and underscores, starting with a letter. Never rename.
// - name:      name shown to the player, in English.
// - name_fr:   French name: the noun with its definite article, wrapped in
//              its gender, such as Masculine("le rat d'ossuaire"),
//              Feminine("la fiole") or Feminine("l'ombre"). The article is
//              `le ` for a masculine noun, `la ` for a feminine one, `l'`
//              before a vowel or a mute h; the sentences of the game are
//              built from it ("l'ombre est brûlée", "un hiérophante").
//              At most 24 characters without the article.
// - plural:    name of several such creatures, in English, as the end
//              screens count them ("2 ossuary rats").
// - plural_fr: the same in French, without an article ("rats d'ossuaire").
// - family:    Vermin, Acolyte, Homunculus, Eye or Spectre; gives the letter
//              drawn on the map (lower case; upper case for the elite).
// - elite:     true for the strong form of the family (upper-case letter).
// - speed:     energy gained per tick; 100 is the player's speed, 200 acts
//              twice per player move.
// - hp:        hit points of a fresh creature.
// - attack:    attack value.
// - defense:   defense value.
// - min_depth: shallowest floor it can appear on, from 1 (the first floor)
//              to 10 (the deepest the content is written for).
//
// How often each creature appears, floor by floor, is set in
// content/spawns.ron. The values are measured in tests/balance.rs, with a
// reckless player (death on floors 2 to 4) and a careful one (median floor
// 6 or 7, a few victories): change them with that test in view.
//
// The two elites are held to what a careful player can beat on floors 5 to
// 7 (decision D24). Against the player's attack of 4, the lead homunculus
// has 16 hit points and a defense of 2 (about two points a blow) and attacks
// for 5; the hierophant has 14 hit points, a defense of 1 and attacks for 4.
// They stay the strongest creatures of their floors, with the most hit
// points and, for the lead homunculus, the hardest blows. A defense of 4
// would leave one point a blow, some 25 blows to kill a lead homunculus,
// and most careful runs would end on those floors; higher attacks would
// leave the seal out of reach of almost every run.
[
    Monster(
        id: "ossuary_rat",
        name: "ossuary rat",
        name_fr: Masculine("le rat d'ossuaire"),
        plural: "ossuary rats",
        plural_fr: "rats d'ossuaire",
        family: Vermin,
        elite: false,
        speed: 150,
        hp: 4,
        attack: 2,
        defense: 0,
        min_depth: 1,
    ),
    Monster(
        id: "wax_beetle",
        name: "wax beetle",
        name_fr: Masculine("le scarabée de cire"),
        plural: "wax beetles",
        plural_fr: "scarabées de cire",
        family: Vermin,
        elite: false,
        speed: 75,
        hp: 8,
        attack: 2,
        defense: 2,
        min_depth: 1,
    ),
    Monster(
        id: "acolyte",
        name: "acolyte",
        name_fr: Masculine("l'acolyte"),
        plural: "acolytes",
        plural_fr: "acolytes",
        family: Acolyte,
        elite: false,
        speed: 100,
        hp: 10,
        attack: 3,
        defense: 1,
        min_depth: 2,
    ),
    Monster(
        id: "homunculus",
        name: "homunculus",
        name_fr: Masculine("l'homoncule"),
        plural: "homunculi",
        plural_fr: "homoncules",
        family: Homunculus,
        elite: false,
        speed: 100,
        hp: 12,
        attack: 4,
        defense: 1,
        min_depth: 2,
    ),
    Monster(
        id: "vigil_eye",
        name: "vigil eye",
        name_fr: Masculine("l'œil veilleur"),
        plural: "vigil eyes",
        plural_fr: "yeux veilleurs",
        family: Eye,
        elite: false,
        speed: 50,
        hp: 6,
        attack: 3,
        defense: 0,
        min_depth: 3,
    ),
    Monster(
        id: "shade",
        name: "shade",
        name_fr: Feminine("l'ombre"),
        plural: "shades",
        plural_fr: "ombres",
        family: Spectre,
        elite: false,
        speed: 125,
        hp: 7,
        attack: 3,
        defense: 0,
        min_depth: 3,
    ),
    Monster(
        id: "hierophant",
        name: "hierophant",
        name_fr: Masculine("le hiérophante"),
        plural: "hierophants",
        plural_fr: "hiérophantes",
        family: Acolyte,
        elite: true,
        speed: 100,
        hp: 14,
        attack: 4,
        defense: 1,
        min_depth: 4,
    ),
    Monster(
        id: "lead_homunculus",
        name: "lead homunculus",
        name_fr: Masculine("l'homoncule plombé"),
        plural: "lead homunculi",
        plural_fr: "homoncules plombés",
        family: Homunculus,
        elite: true,
        speed: 75,
        hp: 16,
        attack: 5,
        defense: 2,
        min_depth: 5,
    ),
]
