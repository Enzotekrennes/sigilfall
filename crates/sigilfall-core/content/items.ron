// Items lying on the floors, which the player picks up, carries and uses
// once. Loaded by `Content::load` and checked before a game starts. Every
// field is required:
//
// - id:        stable key used by saves; lower-case letters, digits and
//              underscores, starting with a letter. Never rename.
// - name:      name shown to the player in English, at most 24 characters,
//              in lower case but for proper nouns ("page of the Veil"), as
//              the names of the creatures: the game writes it inside its
//              sentences ("You drink the healing draught") and only puts a
//              capital at the start of a line of the inventory.
// - name_fr:   French name: the noun with its definite article, wrapped in
//              its gender, such as Masculine("le rat d'ossuaire"),
//              Feminine("la fiole") or Feminine("l'ombre"), in lower case
//              but for proper nouns, as `name`. The article is
//              `le ` for a masculine noun, `la ` for a feminine one, `l'`
//              before a vowel or a mute h; the sentences of the game are
//              built from it ("l'ombre est brûlée", "un hiérophante").
//              At most 24 characters without the article.
// - effect:    what using the item does, which also gives its glyph:
//              Heal(n)            vial: restores n hit points (1 to 99),
//                                 never above the maximum;
//              RestoreEssence(n)  vial: restores n essence (1 to 6), never
//                                 above the maximum;
//              Teach("sigil_id")  page: teaches the sigil of content/sigils.ron
//                                 with that id, as reading its glyph would;
//                                 its min_depth must not be shallower than
//                                 the sigil's;
//              Steady(n)          catalyst: the next n unstable casts are
//                                 cast pure, without backlash (1 to 3, the
//                                 most the player can hold at once).
// - min_depth: shallowest floor the item can be found on, from 1 (the first
//              floor) to 10 (the deepest the content is written for).
//
// How often each item is found, floor by floor, is set in
// content/spawns.ron. Strengths are provisional until items are balanced.
[
    Item(
        id: "healing_draught",
        name: "healing draught",
        name_fr: Masculine("le philtre de soin"),
        effect: Heal(10),
        min_depth: 1,
    ),
    Item(
        id: "essence_phial",
        name: "essence phial",
        name_fr: Feminine("la fiole d'essence"),
        effect: RestoreEssence(4),
        min_depth: 1,
    ),
    Item(
        id: "steadying_ink",
        name: "steadying ink",
        name_fr: Feminine("l'encre d'aplomb"),
        effect: Steady(2),
        min_depth: 1,
    ),
    Item(
        id: "veil_page",
        name: "page of the Veil",
        name_fr: Feminine("la page du Voile"),
        effect: Teach("veil"),
        min_depth: 2,
    ),
]
